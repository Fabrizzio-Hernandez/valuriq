# ==============================================================================
# Valuriq (valuriq.com) Monorepo - .gitignore
# ==============================================================================

# Entornos virtuales y caché de Python
.venv/
venv/
ENV/
__pycache__/
*.py[cod]
*$py.class
*.pyc
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
*.egg-info/
dist/
build/

# Node.js / Angular 19
node_modules/
frontend/node_modules/
frontend/dist/
frontend/.angular/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Bases de datos locales y variables de entorno
.env
.env.*
!.env.example
*.local
*.db
*.sqlite
*.sqlite*

# Archivos temporales de plataformas Cloud (Netlify, Railway, Cloudflare, Vercel, Neon)
.netlify/
.vercel/
.wrangler/
.railway/
deploy-*.zip

# Sistema operativo e IDEs
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*.swo
