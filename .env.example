# ==============================================================================
# Valuriq (valuriq.com) - Variables de Entorno de Ejemplo (.env.example)
# Copiar a .env si se desea personalizar credenciales en local, Docker o Cloud
# ==============================================================================

# PostgreSQL (Docker Compose / Producción)
POSTGRES_USER=valuriq
POSTGRES_PASSWORD=valuriq_secret
POSTGRES_DB=valuriq_db

# Backend FastAPI (SQLAlchemy 2.0 Async + asyncpg)
DATABASE_URL=postgresql+asyncpg://valuriq:valuriq_secret@localhost:5432/valuriq_db

# Orígenes CORS permitidos (admite lista JSON o cadena separada por comas)
CORS_ORIGINS=["http://localhost:4200","http://127.0.0.1:4200","https://valuriq.com","https://www.valuriq.com"]
